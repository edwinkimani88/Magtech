{
  "version": 2,
  "builds": [
    { "src": "index.php", "use": "vercel-php@0.7.3" },
    { "src": "shop.php", "use": "vercel-php@0.7.3" },
    { "src": "product.php", "use": "vercel-php@0.7.3" },
    { "src": "app.php", "use": "vercel-php@0.7.3" },
    { "src": "download.php", "use": "vercel-php@0.7.3" },
    { "src": "setup.php", "use": "vercel-php@0.7.3" },
    { "src": "api/v1/marketplace/sync.php", "use": "vercel-php@0.7.3" },
    { "src": "api/v1/marketplace/photos.php", "use": "vercel-php@0.7.3" },
    { "src": "api/v1/public/items.php", "use": "vercel-php@0.7.3" },
    { "src": "api/v1/public/item.php", "use": "vercel-php@0.7.3" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "downloads/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/downloads/(.*)", "dest": "/downloads/$1" },
    { "src": "/api/v1/marketplace/sync", "dest": "/api/v1/marketplace/sync.php" },
    { "src": "/api/v1/marketplace/photos/upload", "dest": "/api/v1/marketplace/photos.php" },
    { "src": "/api/v1/public/items", "dest": "/api/v1/public/items.php" },
    { "src": "/api/v1/public/items/(.*)", "dest": "/api/v1/public/item.php?id=$1" },
    { "src": "/shop(\\.php)?", "dest": "/shop.php" },
    { "src": "/product(\\.php)?", "dest": "/product.php" },
    { "src": "/app(\\.php)?", "dest": "/app.php" },
    { "src": "/download(\\.php)?", "dest": "/download.php" },
    { "src": "/setup(\\.php)?", "dest": "/setup.php" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
